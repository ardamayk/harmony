{
  "name": "@repo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Earthly Audio Desktop Client: Electron shell around the shared web UI and the Rust core",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "bash ../scripts/run-desktop.sh dev",
    "build": "bash ../scripts/run-desktop.sh build",
    "start": "bash ../scripts/run-desktop.sh start",
    "build:shell": "rm -rf dist && vp pack",
    "prepare:mpv": "./scripts/prepare-mpv-sidecar.sh",
    "test": "vp test",
    "format": "cargo fmt --manifest-path core/Cargo.toml",
    "format:check": "cargo fmt --manifest-path core/Cargo.toml -- --check",
    "lint": "cargo clippy --manifest-path core/Cargo.toml --all-targets -- -D warnings",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "test:mpv": "cargo test --manifest-path core/Cargo.toml --lib playback::tests -- --ignored --test-threads=1 --skip playback::tests::real_pinned_mpv_returns_from_exclusive_to_system_output",
    "test:mpv:hardware": "cargo test --manifest-path core/Cargo.toml playback::tests::real_pinned_mpv_returns_from_exclusive_to_system_output -- --ignored --test-threads=1",
    "test:import-parity": "EARTHLY_AUDIO_MEDIA_PROXY_PORT=0 cargo test --manifest-path core/Cargo.toml --test managed_import_parity -- --ignored --test-threads=1"
  },
  "devDependencies": {
    "@repo/desktop-bridge": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^24",
    "electron": "44.9.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "web": "workspace:*"
  },
  "productName": "Earthly Audio"
}
