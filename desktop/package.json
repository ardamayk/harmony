{
  "name": "@repo/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ../scripts/run-desktop.sh dev",
    "build": "bash ../scripts/run-desktop.sh build",
    "build:sidecar": "bash ../scripts/run-desktop.sh sidecar",
    "build:sidecar:prepared": "bash ../scripts/run-desktop.sh prepared",
    "start": "bash ../scripts/run-desktop.sh start",
    "prepare:mpv": "./scripts/prepare-mpv-sidecar.sh",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:mpv": "cargo test --manifest-path src-tauri/Cargo.toml --lib playback::tests -- --ignored --test-threads=1 --skip playback::tests::real_pinned_mpv_returns_from_exclusive_to_system_output",
    "test:mpv:hardware": "cargo test --manifest-path src-tauri/Cargo.toml playback::tests::real_pinned_mpv_returns_from_exclusive_to_system_output -- --ignored --test-threads=1",
    "test:import-parity": "EARTHLY_AUDIO_MEDIA_PROXY_PORT=0 cargo test --manifest-path src-tauri/Cargo.toml --test managed_import_parity -- --ignored --test-threads=1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "web": "workspace:*"
  }
}
