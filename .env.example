# Root environment (optional overrides)
LOG_LEVEL=info

# Your own Last.fm API key turns on Track play counts (ADR 0030); keep it
# out of git, e.g. in mise.local.toml under [env].
# LASTFM_API_KEY=

# External Source (ADR 0032): a yt-dlp search prefix such as scsearch turns it
# on; unset = off. You install yt-dlp and answer for the source and its terms.
# EXTERNAL_SOURCE_SEARCH=
# Path to yt-dlp when it is not on PATH.
# YT_DLP=
# yt-dlp extractor arguments, space-separated, e.g. youtube:skip=hls,dash.
# EXTERNAL_SOURCE_EXTRACTOR_ARGS=
# The site's name in the clients; unset = named from the prefix (scsearch is
# SoundCloud), else External.
# EXTERNAL_SOURCE_NAME=

# Your own Sentry (ADR 0033): unset = nothing is sent. Keep the DSN out of git.
# SENTRY_DSN=https://<public-key>@<your-sentry-host>/<project-id>
# Unset = development for a debug build, production for a release build.
# SENTRY_ENVIRONMENT=
# Share of transactions sent, 0 to 1; unset = 1.0.
# SENTRY_TRACES_SAMPLE_RATE=

# The Owner's public address behind Cloudflare Access (ADR 0038): all three or
# none. Read server/README.md first; without Access this is the whole server.
# OWNER_PUBLIC_URL=https://music.example.com
# CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# CF_ACCESS_AUD=
