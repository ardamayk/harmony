#!/bin/sh
set -eu

vp staged

if ! git diff --cached --quiet -- \
	packages/contracts/openapi.yaml \
	packages/contracts/oapi-codegen.yaml \
	scripts/generate-openapi.sh \
	scripts/check-openapi-generation.sh; then
	bash scripts/check-staged-generation.sh
fi

# sqlc output must match the staged migrations and queries.
if ! git diff --cached --quiet -- server/sqlc.yaml server/migrations \
	'server/internal/**/*.sql'; then
	(cd server && mise exec -- sqlc diff)
fi
