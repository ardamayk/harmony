    "postcss": "8.5.26",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ]
