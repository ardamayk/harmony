{
  "name": "navidrome-replacement",
  "private": true,
  "workspaces": [
    "desktop",
    "web",
    "packages/*"
  ],
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "dev": "mise run dev",
    "build": "mise run build",
    "check": "mise run check",
    "test": "mise run test",
    "generate": "mise run generate"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
